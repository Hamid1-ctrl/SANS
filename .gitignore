# .gitignore for SANS (.NET + Node.js / React)

# Build outputs & temporary files
**/bin/
**/obj/
**/dist/
**/node_modules/
*.user
*.userosscache
*.sln.docstates

# IDE files
.vs/
.vscode/
.idea/

# Local databases & logs
*.db-shm
*.db-wal
*.log

# Environment files
.env
.env.local
.env.development.local
.env.production.local
